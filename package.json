{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "lint": "npm-run-all lint:*",
    "lint:packages": "pnpm --filter \"./packages/**\" lint",
    "lint:root": "eslint tests",
    "build": "pnpm --filter \"./packages/**\" build",
    "pretest": "pnpm build",
    "serve": "http-server -c-1 -s -p 3000 . --cors --headers '{\"Cross-Origin-Embedder-Policy\":\"require-corp\",\"Cross-Origin-Opener-Policy\":\"same-origin\",\"Cross-Origin-Resource-Policy\":\"cross-origin\",\"Origin-Agent-Cluster\":\"?1\"}'",
    "test": "server-test test:browser:server 3000 test:all",
    "test:all": "npm-run-all test:browser:*:*",
    "test:browser": "mocha-headless-chrome -a enable-features=SharedArrayBuffer",
    "test:browser:core:mt": "pnpm test:browser -- -f http://localhost:3000/tests/ffmpeg-core-mt.test.html",
    "test:browser:core:st": "pnpm test:browser -- -f http://localhost:3000/tests/ffmpeg-core-st.test.html",
    "test:browser:ffmpeg:mt": "pnpm test:browser -- -f http://localhost:3000/tests/ffmpeg-mt.test.html",
    "test:browser:ffmpeg:st": "pnpm test:browser -- -f http://localhost:3000/tests/ffmpeg-st.test.html",
    "test:browser:server": "pnpm serve",
    "test:node": "mocha --exit --bail -t 60000",
    "test:node:core:mt": "pnpm test:node -- --require tests/test-helper-mt.js tests/ffmpeg-core.test.js",
    "test:node:core:st": "pnpm test:node -- --require tests/test-helper-st.js tests/ffmpeg-core.test.js",
    "prepublishOnly": "pnpm build",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "http-server": "^14.1.1",
    "mocha": "^10.2.0",
    "mocha-headless-chrome": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "start-server-and-test": "^2.0.3"
  }
}
